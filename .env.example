CANVAS_BASE_URL=https://your-institution.instructure.com
CANVAS_API_TOKEN=your_canvas_api_token_here
CANVAS_ACCOUNT_ID=your_canvas_account_id_here
PORT=3001

# --- LTI 1.1 (Canvas external tool launch) ---
# Leave false to run standalone exactly as before; true requires the three below.
LTI_ENABLED=false
LTI_CONSUMER_KEY=rep-dashboard-key
LTI_SHARED_SECRET=change-this-to-a-random-secret
SESSION_SECRET=change-this-to-another-random-secret
# User the dashboard reads when LTI_ENABLED=false
LTI_FALLBACK_USER_ID=2619
