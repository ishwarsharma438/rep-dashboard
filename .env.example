CANVAS_BASE_URL=https://your-institution.instructure.com
CANVAS_API_TOKEN=your_canvas_api_token_here
CANVAS_ACCOUNT_ID=your_canvas_account_id_here
PORT=3001

# --- LTI 1.1 (Canvas external tool launch) ---
# Leave false to run standalone exactly as before; true requires the three below.
LTI_ENABLED=false
LTI_CONSUMER_KEY=rep-dashboard-key
LTI_SHARED_SECRET=change-this-to-a-random-secret
SESSION_SECRET=change-this-to-another-random-secret
# User the dashboard reads when LTI_ENABLED=false
LTI_FALLBACK_USER_ID=2619

# --- Canvas Groups (coaching group membership) ---
# Empty = fallback mode: the 16 groups render from static roadmap data and
# join/leave return 503. Fill in after running:
#   node server/scripts/setupGroups.js --confirm
CANVAS_GROUP_CATEGORY_ID=

# --- Session store ---
# Unset = in-memory sessions (fine locally, lost on every restart).
# Set in production so 200 teachers keep their session across deploys.
REDIS_URL=redis://localhost:6379

# --- Resource Hub ---
# Canvas folder whose files the Resource Hub shows. Empty = all course files.
CANVAS_RESOURCE_FOLDER_ID=6079

# --- Admin analytics (Milestone 3) ---
# Optional comma-separated Canvas user ids that always get the admin view. The
# hook for a real admin role/flag later; unset means access is decided only by
# LTI staff roles and Canvas staff enrolments (see middleware/adminAccess.js).
ADMIN_USER_IDS=
# Cohort aggregates are expensive; cached for 5 minutes by default.
ADMIN_CACHE_TTL_MS=
# Canvas calls in flight at once while walking the cohort. Default 6.
ADMIN_CONCURRENCY=

# --- Announcements ---
# Canvas course id of "Welcome to REP", whose announcements are shown to every
# teacher as "Programme Announcements". Empty = that section stays empty and
# only the four courses' announcements appear. Set this once the course exists;
# no code change is needed.
WELCOME_COURSE_ID=
